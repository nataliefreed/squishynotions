{
  "name": "creative-tools",
  "private": true,
  "type": "module",
  "description": "A pocket of small creative tools, published as static files.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/build.mjs && node scripts/serve.mjs --dist",
    "new": "node scripts/new-tool.mjs",
    "import": "bash scripts/import-tool.sh"
  }
}
